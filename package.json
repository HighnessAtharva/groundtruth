{
  "name": "groundtruth",
  "version": "0.1.0",
  "description": "Bind every factual claim in a document to a verbatim quote in a real source, then gate on it.",
  "type": "module",
  "license": "MIT",
  "author": "Atharva Shah",
  "homepage": "https://github.com/HighnessAtharva/groundtruth#readme",
  "repository": { "type": "git", "url": "git+https://github.com/HighnessAtharva/groundtruth.git" },
  "bugs": { "url": "https://github.com/HighnessAtharva/groundtruth/issues" },
  "keywords": ["fact-check", "citations", "provenance", "readability", "seo", "aeo", "content-gate", "markdown"],
  "engines": { "node": ">=20.11" },
  "bin": { "groundtruth": "bin/groundtruth.mjs" },
  "exports": {
    ".": "./src/index.mjs",
    "./presets": "./presets/index.mjs",
    "./adapters": "./src/adapters/index.mjs"
  },
  "files": ["bin", "src", "presets", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/",
    "check": "node bin/groundtruth.mjs check",
    "report": "node bin/groundtruth.mjs report"
  },
  "dependencies": { "yaml": "^2.5.1" }
}
