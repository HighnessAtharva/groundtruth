{
  "name": "groundtruth",
  "version": "0.1.0",
  "description": "Bind every factual claim in a document to a verbatim quote in a real source, then fail the build when the binding breaks. Provenance, readability and SEO checks for markdown.",
  "type": "module",
  "license": "MIT",
  "author": "Atharva Shah",
  "homepage": "https://github.com/HighnessAtharva/groundtruth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HighnessAtharva/groundtruth.git"
  },
  "bugs": {
    "url": "https://github.com/HighnessAtharva/groundtruth/issues"
  },
  "keywords": [
    "fact-check",
    "fact-checking",
    "citations",
    "provenance",
    "verification",
    "sources",
    "markdown",
    "linter",
    "prose",
    "readability",
    "seo",
    "aeo",
    "answer-engine",
    "content-gate",
    "documentation",
    "docs",
    "technical-writing",
    "ci",
    "sarif",
    "claude"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "groundtruth": "bin/groundtruth.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./presets": "./presets/index.mjs",
    "./adapters": "./src/adapters/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "presets",
    "skills",
    "commands",
    "agents",
    "hooks",
    ".claude-plugin",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".nvmrc"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:examples": "node scripts/verify-examples.mjs",
    "test:offline": "node scripts/verify-examples.mjs --offline",
    "test:all": "npm test && npm run test:examples && npm run test:offline",
    "check": "node bin/groundtruth.mjs check",
    "report": "node bin/groundtruth.mjs report",
    "self": "node bin/groundtruth.mjs check --config .selfcheck.config.mjs",
    "self:report": "node bin/groundtruth.mjs report --config .selfcheck.config.mjs",
    "bench": "node scripts/bench.mjs",
    "prepublishOnly": "npm test && npm run test:examples"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
